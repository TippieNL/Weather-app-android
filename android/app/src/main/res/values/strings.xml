    <string name="about_services">Data &amp; services</string>
    <string name="about_privacy">No ads, no analytics, no tracking. Your location goes to these services only to fetch weather, radar and place names for it. API keys are encrypted with the Android Keystore and only ever sent to the provider they belong to.</string>
    <string name="about_service_open_meteo">The default forecast: current weather, hourly and 7-day outlook, and the 15-minute rain nowcast. No key needed.</string>
